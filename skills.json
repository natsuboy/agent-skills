{
  "version": "1.0.0",
  "repository": {
    "owner": "YOUR_USERNAME",
    "repo": "agent-skills"
  },
  "skills": {
    "mermaid": {
      "name": "mermaid",
      "displayName": "Mermaid Diagrams Skill",
      "version": "1.0.0",
      "description": "专业的 Mermaid 图表生成 Skill，为 AI Agent 提供高质量、美观、语法正确的图表创建能力",
      "author": {
        "name": "Your Name",
        "email": "your.email@example.com"
      },
      "installer": {
        "packageName": "mermaid-skill-installer",
        "scope": "",
        "binName": "install-mermaid-skill"
      },
      "files": {
        "include": [
          "SKILL.md",
          "README.md",
          "scripts/",
          "references/",
          "assets/"
        ],
        "exclude": [
          "**/__pycache__",
          "**/*.pyc",
          "**/.ruff_cache",
          "**/.DS_Store",
          "**/node_modules"
        ]
      },
      "dependencies": {
        "runtime": {
          "python": ">=3.8",
          "node": ">=14.0"
        },
        "build": {
          "tar": "*",
          "shasum": "*"
        }
      },
      "keywords": [
        "mermaid",
        "diagram",
        "diagrams",
        "charts",
        "visualization",
        "ai-agent",
        "skill"
      ]
    }
  }
}
